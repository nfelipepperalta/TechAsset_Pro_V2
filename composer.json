{
    "name": "techasset/techasset-pro",
    "description": "Sistema de Inventario de Activos Tecnológicos Empresariales",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "endroid/qr-code": "^5.0",
        "pragmarx/google2fa": "^9.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Core\\":          "core/",
            "Config\\":        "config/",
            "Controllers\\":   "controllers/",
            "Services\\":      "services/",
            "Repositories\\":  "repositories/",
            "Helpers\\":       "helpers/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "php -r \"copy('.env.example', '.env');\" 2>/dev/null || true"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
